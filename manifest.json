{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "ru",
  "homepage_url": "https://github.com/Beetlejuice8921/videoroom",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/Beetlejuice8921/videoroom-rooms/*"
  ],
  "action": {
    "default_title": "Videoroom",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content/page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/shared/rooms.js",
        "src/shared/venue-map.js",
        "src/content/audio-sync.js",
        "src/content/angle-search.js",
        "src/content/content.js"
      ],
      "css": [
        "src/shared/venue-map.css",
        "src/content/content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://beetlejuice8921.github.io/videoroom-cinema/*"
      ],
      "js": [
        "src/shared/rooms.js",
        "src/content/cinema-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
